LIQUIDSNIPER_MODE=paper
LIQUIDSNIPER_DB_PATH=/var/lib/liquidsniper/db/liquidsniper.sqlite
LIQUIDSNIPER_ARTIFACT_ROOT=/var/lib/liquidsniper/artifacts
LS_ARTIFACT_ROOT=/var/lib/liquidsniper/artifacts
LIQUIDSNIPER_PAPER_BANKROLL_USD=2000
LIQUIDSNIPER_MAX_DAILY_LOSS_USD=500
LIQUIDSNIPER_MAX_CLUSTER_LOSS_USD=300
LIQUIDSNIPER_LOOP_SECONDS=60
LIQUIDSNIPER_PROFILE_MODE=intraday_only
LIQUIDSNIPER_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,SUIUSDT
LIQUIDSNIPER_RISK_USD_PER_TRADE=25
LIQUIDSNIPER_HEALTH_PATH=/var/lib/liquidsniper/logs/paper_runner.health.json
LIQUIDSNIPER_SCORECARD_HEALTH_PATH=/var/lib/liquidsniper/logs/scorecard_worker.health.json
