# LiquidSniper Phase 1 docker-compose env
# Copy to .env and fill values before first run.
# Safety baseline: fail-closed defaults only (paper/sim mode, no live creds).

# Telegram ingestion (operator provided)
LIQUIDSNIPER_TELEGRAM_API_ID=
LIQUIDSNIPER_TELEGRAM_API_HASH=
MOBCHART_BOT_USERNAME=@MobChartBot

# Execution mode (fail-closed default)
LIQUIDSNIPER_EXECUTION_MODE=paper
LIQUIDSNIPER_SIMULATION_ENABLED=true

# Blofin dependency (operator-owned; keep disabled until explicit sign-off)
LIQUIDSNIPER_BLOFIN_ENABLED=false
LIQUIDSNIPER_BLOFIN_API_KEY=__OPERATOR_REQUIRED__
LIQUIDSNIPER_BLOFIN_API_SECRET=__OPERATOR_REQUIRED__
LIQUIDSNIPER_BLOFIN_API_PASSPHRASE=__OPERATOR_REQUIRED__

# On-chain dependency (operator-owned; disabled by default)
LIQUIDSNIPER_ONCHAIN_ENABLED=false
LIQUIDSNIPER_ONCHAIN_ALLOWLIST=__DISABLED_UNTIL_APPROVED__

# Egress posture (must be verified before anything beyond paper)
LIQUIDSNIPER_EGRESS_VERIFIED=false
LIQUIDSNIPER_EGRESS_PROFILE=__UNVERIFIED__

# Promotion gate (no progression beyond paper without explicit operator sign-off)
LIQUIDSNIPER_OPERATOR_SIGNOFF_REQUIRED=true
LIQUIDSNIPER_OPERATOR_SIGNOFF_TOKEN=__REQUIRED_FOR_NON_PAPER__
