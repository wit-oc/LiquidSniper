//@version=5
indicator("HTF Phase 1 Structure v2 (Mechanical FSM)", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

// Mechanical-only Phase 1 structure state machine.
// Rules:
// 1) break/close threshold is fixed at 0 (close beyond level only).
// 2) CHoCH can only trigger while in confirmed state.
// 3) Single active transition at a time.
// 4) Transitional state resolves/reverts by deterministic gates.
// 5) Explicit debug reason codes are exposed in debug table.

leftBars = input.int(2, "Pivot Left", minval=1)
rightBars = input.int(2, "Pivot Right", minval=1)
initialBullish = input.bool(true, "Initial Regime Bullish")
showSwingLabels = input.bool(false, "Show SH/SL pivot labels")
showDebug = input.bool(true, "Show debug diagnostics")

// breakMinFrac hard-fixed to 0 by design.
breakMinFrac = 0.0

acceptedBreakAbove(level) =>
    rng = math.max(1e-9, high - low)
    close > level and (close - level) >= breakMinFrac * rng

acceptedBreakBelow(level) =>
    rng = math.max(1e-9, high - low)
    close < level and (level - close) >= breakMinFrac * rng

ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

var string regimeDir = initialBullish ? "bullish" : "bearish"
var string regimeConf = "confirmed" // confirmed | transitional
var string transitionSide = ""      // bull_to_bear | bear_to_bull | ""
var string transitionReason = ""

var float protectedLow = low
var int protectedLowIdx = bar_index
var float protectedHigh = high
var int protectedHighIdx = bar_index

var float validatedHigh = na
var int validatedHighIdx = na
var float validatedLow = na
var int validatedLowIdx = na

var float candHigh = high
var int candHighIdx = bar_index
var float candHighOpp = low
var int candHighOppIdx = bar_index

var float candLow = low
var int candLowIdx = bar_index
var float candLowOpp = high
var int candLowOppIdx = bar_index

var float activeChochLevel = na
var int activeChochIndex = na
var int transitionLatchIndex = na

bool evBos = false
bool evChoch = false
bool evSfp = false
float sfpY = na

string dbgBosReason = "B_NONE"
string dbgChochReason = "C_NONE"
string dbgTransitionReason = "T_NONE"
bool dbgAcceptedBreakUp = false
bool dbgAcceptedBreakDown = false

float bosFromPrice = na
int bosFromIdx = na
float chochFromPrice = na
int chochFromIdx = na

if barstate.isfirst
    if regimeDir == "bullish"
        validatedHigh := high
        validatedHighIdx := bar_index
    else
        validatedLow := low
        validatedLowIdx := bar_index

if not na(ph)
    pivotIndex = bar_index - rightBars
    pivotPrice = ph
    if showSwingLabels
        label.new(pivotIndex, pivotPrice, "SH", style=label.style_label_down, textcolor=color.white, color=color.new(color.blue, 0), size=size.tiny)

if not na(pl)
    pivotIndex = bar_index - rightBars
    pivotPrice = pl
    if showSwingLabels
        label.new(pivotIndex, pivotPrice, "SL", style=label.style_label_up, textcolor=color.white, color=color.new(color.orange, 0), size=size.tiny)

transitionReason := ""

if regimeDir == "bullish"
    if high > candHigh
        candHigh := high
        candHighIdx := bar_index
        candHighOpp := low
        candHighOppIdx := bar_index

    if not na(validatedHigh) and high >= validatedHigh and close <= validatedHigh
        evSfp := true
        sfpY := high
        validatedHigh := high
        validatedHighIdx := bar_index

    if low <= protectedLow and close >= protectedLow
        evSfp := true
        sfpY := na(sfpY) ? low : sfpY

    if bar_index > candHighIdx and low <= candHighOpp and high <= candHigh
        if validatedHighIdx != candHighIdx
            validatedHigh := candHigh
            validatedHighIdx := candHighIdx
            if regimeConf == "confirmed" and candHighOpp > protectedLow
                protectedLow := candHighOpp
                protectedLowIdx := candHighOppIdx

    dbgAcceptedBreakUp := not na(validatedHigh) and acceptedBreakAbove(validatedHigh)
    startBull = na(validatedHighIdx) ? bar_index : validatedHighIdx
    lenBull = math.max(1, bar_index - startBull + 1)
    lockLow = ta.lowest(low, lenBull)
    lockIdx = ta.lowestbars(low, lenBull)

    if dbgAcceptedBreakUp
        protectedLow := lockLow
        protectedLowIdx := bar_index + lockIdx
        evBos := true
        bosFromPrice := validatedHigh
        bosFromIdx := startBull
        dbgBosReason := "B_BULL_PASS"

        regimeConf := "confirmed"
        transitionSide := ""
        transitionReason := "bos_confirmed"
        activeChochLevel := na
        activeChochIndex := na
        transitionLatchIndex := na
        validatedHigh := high
        validatedHighIdx := bar_index
    else
        dbgBosReason := na(validatedHigh) ? "B_BULL_BLOCK_NO_VALID" : "B_BULL_BLOCK_CLOSE"

    dbgAcceptedBreakDown := acceptedBreakBelow(protectedLow)
    if regimeConf != "confirmed"
        dbgChochReason := "C_B2B_BLOCK_NOT_CONFIRMED"
    else if transitionSide != ""
        dbgChochReason := "C_B2B_BLOCK_TRANSITION_ACTIVE"
    else if dbgAcceptedBreakDown
        regimeDir := "bearish"
        regimeConf := "transitional"
        transitionSide := "bull_to_bear"
        transitionReason := "choch_detected"
        activeChochLevel := protectedLow
        activeChochIndex := bar_index
        transitionLatchIndex := protectedLowIdx

        protectedHigh := validatedHigh
        protectedHighIdx := nz(validatedHighIdx, bar_index)
        candLow := low
        candLowIdx := bar_index
        candLowOpp := high
        candLowOppIdx := bar_index
        validatedLow := low
        validatedLowIdx := bar_index

        evChoch := true
        chochFromPrice := protectedLow
        chochFromIdx := protectedLowIdx
        dbgChochReason := "C_B2B_PASS"
    else
        dbgChochReason := "C_B2B_BLOCK_CLOSE"

else
    if low < candLow
        candLow := low
        candLowIdx := bar_index
        candLowOpp := high
        candLowOppIdx := bar_index

    if not na(validatedLow) and low <= validatedLow and close >= validatedLow
        evSfp := true
        sfpY := low
        validatedLow := low
        validatedLowIdx := bar_index

    if high >= protectedHigh and close <= protectedHigh
        evSfp := true
        sfpY := na(sfpY) ? high : sfpY

    if bar_index > candLowIdx and high >= candLowOpp and low >= candLow
        if validatedLowIdx != candLowIdx
            validatedLow := candLow
            validatedLowIdx := candLowIdx
            if regimeConf == "confirmed" and candLowOpp < protectedHigh
                protectedHigh := candLowOpp
                protectedHighIdx := candLowOppIdx

    dbgAcceptedBreakDown := not na(validatedLow) and acceptedBreakBelow(validatedLow)
    startBear = na(validatedLowIdx) ? bar_index : validatedLowIdx
    lenBear = math.max(1, bar_index - startBear + 1)
    lockHigh = ta.highest(high, lenBear)
    lockIdx = ta.highestbars(high, lenBear)

    if dbgAcceptedBreakDown
        protectedHigh := lockHigh
        protectedHighIdx := bar_index + lockIdx
        evBos := true
        bosFromPrice := validatedLow
        bosFromIdx := startBear
        dbgBosReason := "B_BEAR_PASS"

        regimeConf := "confirmed"
        transitionSide := ""
        transitionReason := "bos_confirmed"
        activeChochLevel := na
        activeChochIndex := na
        transitionLatchIndex := na
        validatedLow := low
        validatedLowIdx := bar_index
    else
        dbgBosReason := na(validatedLow) ? "B_BEAR_BLOCK_NO_VALID" : "B_BEAR_BLOCK_CLOSE"

    dbgAcceptedBreakUp := acceptedBreakAbove(protectedHigh)
    if regimeConf != "confirmed"
        dbgChochReason := "C_B2U_BLOCK_NOT_CONFIRMED"
    else if transitionSide != ""
        dbgChochReason := "C_B2U_BLOCK_TRANSITION_ACTIVE"
    else if dbgAcceptedBreakUp
        regimeDir := "bullish"
        regimeConf := "transitional"
        transitionSide := "bear_to_bull"
        transitionReason := "choch_detected"
        activeChochLevel := protectedHigh
        activeChochIndex := bar_index
        transitionLatchIndex := protectedHighIdx

        protectedLow := validatedLow
        protectedLowIdx := nz(validatedLowIdx, bar_index)
        candHigh := high
        candHighIdx := bar_index
        candHighOpp := low
        candHighOppIdx := bar_index
        validatedHigh := high
        validatedHighIdx := bar_index

        evChoch := true
        chochFromPrice := protectedHigh
        chochFromIdx := protectedHighIdx
        dbgChochReason := "C_B2U_PASS"
    else
        dbgChochReason := "C_B2U_BLOCK_CLOSE"

// Deterministic transition resolver/reverter.
if regimeConf == "transitional"
    if transitionSide == "bull_to_bear"
        if not na(validatedLow) and acceptedBreakBelow(validatedLow)
            regimeConf := "confirmed"
            transitionSide := ""
            transitionReason := "bos_confirmed"
            activeChochLevel := na
            activeChochIndex := na
            transitionLatchIndex := na
            dbgTransitionReason := "T_B2B_RESOLVE"
        else if acceptedBreakAbove(protectedHigh)
            regimeDir := "bullish"
            regimeConf := "confirmed"
            transitionSide := ""
            transitionReason := "choch_reverted"
            activeChochLevel := na
            activeChochIndex := na
            transitionLatchIndex := na
            dbgTransitionReason := "T_B2B_REVERT"
        else
            dbgTransitionReason := "T_B2B_WAIT"
    else if transitionSide == "bear_to_bull"
        if not na(validatedHigh) and acceptedBreakAbove(validatedHigh)
            regimeConf := "confirmed"
            transitionSide := ""
            transitionReason := "bos_confirmed"
            activeChochLevel := na
            activeChochIndex := na
            transitionLatchIndex := na
            dbgTransitionReason := "T_B2U_RESOLVE"
        else if acceptedBreakBelow(protectedLow)
            regimeDir := "bearish"
            regimeConf := "confirmed"
            transitionSide := ""
            transitionReason := "choch_reverted"
            activeChochLevel := na
            activeChochIndex := na
            transitionLatchIndex := na
            dbgTransitionReason := "T_B2U_REVERT"
        else
            dbgTransitionReason := "T_B2U_WAIT"
    else
        // Guardrail: transitional without side is invalid; deterministically recover.
        regimeConf := "confirmed"
        transitionReason := "transition_invalid_reset"
        dbgTransitionReason := "T_INVALID_RESET"

if protectedHigh < protectedLow
    mid = (protectedHigh + protectedLow) / 2.0
    protectedHigh := mid
    protectedLow := mid
    if dbgBosReason == "B_NONE"
        dbgBosReason := "B_INVARIANT_FIX"

plotshape(evBos, title="BoS", style=shape.diamond, location=location.abovebar, color=color.new(color.green, 0), size=size.tiny, text="BoS")
plotshape(evChoch, title="CHoCH", style=shape.triangleup, location=location.abovebar, color=color.new(color.yellow, 0), size=size.tiny, text="CHoCH")
plotshape(evSfp ? sfpY : na, title="SFP", style=shape.circle, location=location.absolute, color=color.new(color.aqua, 0), size=size.tiny, text="SFP")

if evBos and not na(bosFromPrice) and not na(bosFromIdx)
    line.new(bosFromIdx, bosFromPrice, bar_index, close, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.green, 0), width=2)

if evChoch and not na(chochFromPrice) and not na(chochFromIdx)
    line.new(chochFromIdx, chochFromPrice, bar_index, close, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.yellow, 0), width=2)

plot(validatedHigh, title="Active Swing High", color=color.new(color.blue, 0), linewidth=2, style=plot.style_linebr)
plot(validatedLow, title="Active Swing Low", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)

regimeColor = regimeDir == "bullish" ? (regimeConf == "confirmed" ? color.new(color.green, 0) : color.new(color.green, 55)) : (regimeConf == "confirmed" ? color.new(color.red, 0) : color.new(color.red, 55))
bgcolor(color.new(regimeColor, 88))

var table t = table.new(position.top_right, 1, 13, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Dir: " + regimeDir, text_color=color.white, bgcolor=color.new(regimeColor, 0))
    table.cell(t, 0, 1, "Conf: " + regimeConf, text_color=color.white, bgcolor=color.new(regimeColor, 20))
    table.cell(t, 0, 2, "Transition Side: " + (transitionSide == "" ? "-" : transitionSide), text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 0, 3, "Reason: " + (transitionReason == "" ? "-" : transitionReason), text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 0, 4, "Protected H/L: " + str.tostring(protectedHigh, format.mintick) + " / " + str.tostring(protectedLow, format.mintick), text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 0, 5, "Active CHoCH: " + (na(activeChochLevel) ? "-" : str.tostring(activeChochLevel, format.mintick)), text_color=color.white, bgcolor=color.new(color.black, 0))
    if showDebug
        table.cell(t, 0, 6, "Validated H/L: " + str.tostring(validatedHigh, format.mintick) + " / " + str.tostring(validatedLow, format.mintick), text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(t, 0, 7, "AcceptedBreak Up/Down: " + str.tostring(dbgAcceptedBreakUp) + " / " + str.tostring(dbgAcceptedBreakDown), text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(t, 0, 8, "B reason: " + dbgBosReason, text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(t, 0, 9, "C reason: " + dbgChochReason, text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(t, 0, 10, "T reason: " + dbgTransitionReason, text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(t, 0, 11, "Prot idx H/L: " + str.tostring(protectedHighIdx) + " / " + str.tostring(protectedLowIdx), text_color=color.white, bgcolor=color.new(color.black, 0))
        table.cell(t, 0, 12, "Transition latch idx: " + str.tostring(transitionLatchIndex), text_color=color.white, bgcolor=color.new(color.black, 0))
