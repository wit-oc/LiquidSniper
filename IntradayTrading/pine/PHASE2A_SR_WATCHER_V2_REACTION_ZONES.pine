//@version=5
indicator("Phase2A S/R Watcher V2 (Reaction-Zone Qualified)", overlay=true, max_boxes_count=220, max_lines_count=220, max_labels_count=300)

// =====================================================
// Phase2A V2 (Foxian-aligned draft)
// - Reaction-first zone boundaries (not fixed ATR width bands)
// - 3-touch + reaction qualification gate
// - Candidate -> Qualified -> FlipCandidate -> Flipped/Invalid
// - Historical retention with weakest-drop (not strict FIFO)
// =====================================================

// ---------- Inputs ----------
pivotL              = input.int(8, "Pivot Left", minval=1)
pivotR              = input.int(8, "Pivot Right", minval=1)
minPivotStrength    = input.float(0.95, "Min pivot strength", minval=0.1, step=0.05)

minQualifiedTouches = input.int(3, "Min qualified touches", minval=1)
reactionMoveK       = input.float(0.25, "Reaction move K (x zone height)", minval=0.05, step=0.05)
reactionWindowBars  = input.int(8, "Reaction window bars", minval=1)
edgeHitEpsK         = input.float(0.35, "Edge-hit epsilon K (x zone height)", minval=0.01, step=0.01)
requireDualEdge     = input.bool(true, "Require both edge types to qualify")
minEdgeHits         = input.int(1, "Min edge hits per required side", minval=1)

mergeOverlap        = input.float(0.35, "Merge overlap", minval=0.0, maxval=1.0, step=0.01)
minZoneSpacing      = input.float(1.25, "Min zone spacing x height", minval=0.1, step=0.05)

closeBreakTolK      = input.float(0.05, "closeBreakTolK", minval=0.0, step=0.01)
sepK                = input.float(0.75, "sepK", minval=0.0, step=0.05)
baseTolK            = input.float(1.00, "baseTolK", minval=0.1, step=0.05)
baseBarsMin         = input.int(4, "baseBarsMin", minval=1)
baseBarsMax         = input.int(6, "baseBarsMax", minval=1)
reclaimK            = input.float(0.25, "reclaimK", minval=0.0, step=0.01)
flipConfirmWindow   = input.int(12, "flipConfirmWindowBars", minval=1)

touchEpsilonK       = input.float(0.03, "touchEpsilonK", minval=0.0, step=0.01)
maxZoneHeightPct    = input.float(0.08, "Max zone height % of level", minval=0.01, step=0.01)

maxZonesInternal    = input.int(140, "Max zones internal (history pool)", minval=10, maxval=200)
maxDisplayZones     = input.int(12, "Max displayed zones", minval=1, maxval=40)
displayFocusPrice   = input.float(0.0, "Display focus price (0 = current close)", minval=0.0, step=100.0)
proximityWeight     = input.float(2.0, "Display proximity weight", minval=0.0, step=0.25)
diagTargetPrice     = input.float(72000.0, "Diagnostic target price", minval=0.0, step=100.0)
showDiagTarget      = input.bool(true, "Show target diagnostics")
showCandidates      = input.bool(false, "Show candidate zones")
candidateFallback   = input.bool(true, "Show candidates when no qualified zones")
showReasonLabels    = input.bool(false, "Show major reason labels")
showZoneMidline     = input.bool(true, "Show zone midline")
showSideStyle       = input.bool(false, "Support solid / Resistance dashed")
colorBySide         = input.bool(false, "Color by support/resistance side")
highContrastZones   = input.bool(true, "High-contrast zones")
showDebugTable      = input.bool(true, "Show debug table")

htfTf               = input.timeframe("240", "HTF timeframe marker")
showHtfMarkers      = input.bool(true, "Show HTF pivot markers")

// ---------- Constants ----------
STATE_CANDIDATE     = 0
STATE_QUALIFIED     = 1
STATE_FLIP_CAND     = 2
STATE_FLIPPED       = 3
STATE_INVALID       = 4

SIDE_SUPPORT        = 1
SIDE_RESIST         = -1

// ---------- Storage ----------
var zTop            = array.new_float()
var zBot            = array.new_float()
var zMid            = array.new_float()
var zSide           = array.new_int()
var zState          = array.new_int()
var zStrength       = array.new_float()

var zTouches        = array.new_int()      // all intersects
var zQTouches       = array.new_int()      // reaction-confirmed touches
var zUpperHits      = array.new_int()      // near top edge
var zLowerHits      = array.new_int()      // near bottom edge

var zPending        = array.new_bool()     // waiting for reaction validation
var zPendBar        = array.new_int()
var zPendHigh       = array.new_float()
var zPendLow        = array.new_float()
var zPendBody       = array.new_float()

var zBreakBar       = array.new_int()
var zSepSeen        = array.new_bool()
var zBaseCount      = array.new_int()

var zCreatedBar     = array.new_int()
var zOriginTime     = array.new_int()
var zLastTouchBar   = array.new_int()

var zVisible        = array.new_bool()
var zBox            = array.new_box()
var zLine           = array.new_line()

atrv = ta.atr(14)

// ---------- Helpers ----------
f_reason(_txt, _y, _c) =>
    if showReasonLabels
        _ = label.new(bar_index, _y, _txt, style=label.style_label_left, textcolor=color.white, color=_c, size=size.tiny)

f_height(_top, _bot) =>
    math.max(syminfo.mintick * 2.0, _top - _bot)

f_overlap_ratio(_t1, _b1, _t2, _b2) =>
    interTop = math.min(_t1, _t2)
    interBot = math.max(_b1, _b2)
    inter = math.max(0.0, interTop - interBot)
    uni = math.max(_t1, _t2) - math.min(_b1, _b2)
    uni > 0 ? inter / uni : 0.0

f_state_weight(_state) =>
    _state == STATE_QUALIFIED ? 2.0 : _state == STATE_FLIPPED ? 2.5 : _state == STATE_FLIP_CAND ? 1.5 : _state == STATE_CANDIDATE ? 0.5 : -2.0

f_state_name(_state) =>
    _state == STATE_CANDIDATE ? "CAND" :
      _state == STATE_QUALIFIED ? "QUAL" :
      _state == STATE_FLIP_CAND ? "FLIP_C" :
      _state == STATE_FLIPPED ? "FLIPPED" : "INVALID"

f_score(i) =>
    st = array.get(zState, i)
    str = array.get(zStrength, i)
    qt = array.get(zQTouches, i)
    tt = array.get(zTouches, i)
    edge = math.min(array.get(zUpperHits, i), array.get(zLowerHits, i))
    str + qt * 1.8 + tt * 0.20 + edge * 0.6 + f_state_weight(st)

f_display_score(i) =>
    base = f_score(i)
    mid = array.get(zMid, i)
    top = array.get(zTop, i)
    bot = array.get(zBot, i)
    focus = displayFocusPrice > 0.0 ? displayFocusPrice : close
    denom = math.max(math.abs(focus), syminfo.mintick)
    prox = 1.0 / (1.0 + math.abs(mid - focus) / denom)
    hPct = f_height(top, bot) / math.max(math.abs(mid), syminfo.mintick)
    giantPenalty = math.max(0.0, hPct - maxZoneHeightPct) * 50.0
    base + proximityWeight * prox - giantPenalty

f_fill_color(_state, _side) =>
    aC = highContrastZones ? 72 : 88
    aQ = highContrastZones ? 58 : 82
    aF = highContrastZones ? 52 : 78
    aI = highContrastZones ? 58 : 82
    baseCand = colorBySide ? (_side == SIDE_SUPPORT ? color.new(color.green, aC) : color.new(color.purple, aC)) : color.new(color.blue, aC)
    baseQual = colorBySide ? (_side == SIDE_SUPPORT ? color.new(color.green, aQ) : color.new(color.purple, aQ)) : color.new(color.blue, aQ)
    _state == STATE_INVALID ? color.new(color.red, aI) :
      _state == STATE_FLIP_CAND ? color.new(color.orange, aF) :
      _state == STATE_FLIPPED ? color.new(color.aqua, aF) :
      _state == STATE_QUALIFIED ? baseQual : baseCand

f_border_color(_state, _side) =>
    base = colorBySide ? (_side == SIDE_SUPPORT ? color.new(color.lime, 0) : color.new(color.fuchsia, 0)) : color.new(color.blue, 0)
    _state == STATE_INVALID ? color.new(color.red, 0) :
      _state == STATE_FLIP_CAND ? color.new(color.orange, 0) :
      _state == STATE_FLIPPED ? color.new(color.aqua, 0) :
      base

f_cap_zone_height(i) =>
    top = array.get(zTop, i)
    bot = array.get(zBot, i)
    mid = array.get(zMid, i)
    h = f_height(top, bot)
    capH = math.max(syminfo.mintick * 4.0, math.abs(mid) * maxZoneHeightPct)
    if h > capH
        half = capH * 0.5
        array.set(zTop, i, mid + half)
        array.set(zBot, i, mid - half)

f_remove_at(idx) =>
    b = array.get(zBox, idx)
    if not na(b)
        box.delete(b)
    l = array.get(zLine, idx)
    if not na(l)
        line.delete(l)

    array.remove(zTop, idx)
    array.remove(zBot, idx)
    array.remove(zMid, idx)
    array.remove(zSide, idx)
    array.remove(zState, idx)
    array.remove(zStrength, idx)

    array.remove(zTouches, idx)
    array.remove(zQTouches, idx)
    array.remove(zUpperHits, idx)
    array.remove(zLowerHits, idx)

    array.remove(zPending, idx)
    array.remove(zPendBar, idx)
    array.remove(zPendHigh, idx)
    array.remove(zPendLow, idx)
    array.remove(zPendBody, idx)

    array.remove(zBreakBar, idx)
    array.remove(zSepSeen, idx)
    array.remove(zBaseCount, idx)

    array.remove(zCreatedBar, idx)
    array.remove(zOriginTime, idx)
    array.remove(zLastTouchBar, idx)

    array.remove(zVisible, idx)
    array.remove(zBox, idx)
    array.remove(zLine, idx)

f_trim_weakest() =>
    while array.size(zTop) > maxZonesInternal
        sz = array.size(zTop)
        weakestIdx = 0
        weakestScore = f_score(0)
        if sz > 1
            for i = 1 to sz - 1
                sc = f_score(i)
                if sc < weakestScore
                    weakestScore := sc
                    weakestIdx := i
        f_remove_at(weakestIdx)

f_rebuild_mid(i) =>
    t = array.get(zTop, i)
    b = array.get(zBot, i)
    if t <= b
        t := b + syminfo.mintick * 2.0
        array.set(zTop, i, t)
    array.set(zMid, i, (t + b) * 0.5)

f_new_zone(_top, _bot, _side, _strength, _originTime) =>
    _left = _originTime
    _h = f_height(_top, _bot)
    _mid = (_top + _bot) * 0.5

    bool dropped = false
    zCount = array.size(zTop)

    if zCount > 0
        rev = zCount - 1
        for _j = 0 to zCount - 1
            i = rev - _j
            if not dropped
                iSide = array.get(zSide, i)
                if iSide == _side and array.get(zState, i) != STATE_INVALID
                    iTop = array.get(zTop, i)
                    iBot = array.get(zBot, i)
                    iMid = array.get(zMid, i)
                    iH = f_height(iTop, iBot)
                    ov = f_overlap_ratio(_top, _bot, iTop, iBot)
                    spacing = math.abs(_mid - iMid) / math.max(_h, iH)

                    if ov > mergeOverlap or spacing < minZoneSpacing
                        iSc = f_score(i)
                        nSc = _strength + 0.25
                        if nSc > iSc
                            leftKeep = math.min(array.get(zOriginTime, i), _left)
                            array.set(zTop, i, _top)
                            array.set(zBot, i, _bot)
                            array.set(zMid, i, _mid)
                            array.set(zStrength, i, _strength)
                            array.set(zState, i, STATE_CANDIDATE)
                            array.set(zTouches, i, 0)
                            array.set(zQTouches, i, 0)
                            array.set(zUpperHits, i, 0)
                            array.set(zLowerHits, i, 0)
                            array.set(zPending, i, false)
                            array.set(zPendBar, i, na)
                            array.set(zPendHigh, i, na)
                            array.set(zPendLow, i, na)
                            array.set(zPendBody, i, na)
                            array.set(zBreakBar, i, na)
                            array.set(zSepSeen, i, false)
                            array.set(zBaseCount, i, 0)
                            array.set(zCreatedBar, i, bar_index)
                            array.set(zOriginTime, i, leftKeep)
                            array.set(zLastTouchBar, i, na)
                            f_reason("SR_ZONE_MERGED_STRONGER", _mid, color.new(color.teal, 15))
                            array.set(zLastTouchBar, i, array.get(zLastTouchBar, i))
                        else
                            dropped := true

    if not dropped
        array.push(zTop, _top)
        array.push(zBot, _bot)
        array.push(zMid, _mid)
        array.push(zSide, _side)
        array.push(zState, STATE_CANDIDATE)
        array.push(zStrength, _strength)

        array.push(zTouches, 0)
        array.push(zQTouches, 0)
        array.push(zUpperHits, 0)
        array.push(zLowerHits, 0)

        array.push(zPending, false)
        array.push(zPendBar, na)
        array.push(zPendHigh, na)
        array.push(zPendLow, na)
        array.push(zPendBody, na)

        array.push(zBreakBar, na)
        array.push(zSepSeen, false)
        array.push(zBaseCount, 0)

        array.push(zCreatedBar, bar_index)
        array.push(zOriginTime, _left)
        array.push(zLastTouchBar, na)

        array.push(zVisible, false)
        b = box.new(_left, _top, time, _bot, xloc=xloc.bar_time, border_color=color.new(color.white, 70), border_width=2, bgcolor=color.new(color.white, 100))
        l = line.new(_left, _mid, time, _mid, xloc=xloc.bar_time, extend=extend.none, color=color.new(color.white, 100), width=1)
        array.push(zBox, b)
        array.push(zLine, l)
        f_reason("SR_ZONE_CREATED", _mid, color.new(color.blue, 20))
        _noop = 0

    f_trim_weakest()

f_touch_reaction_update(i) =>
    st = array.get(zState, i)
    if st != STATE_INVALID
        top = array.get(zTop, i)
        bot = array.get(zBot, i)
        h = f_height(top, bot)
        side = array.get(zSide, i)

        eps = touchEpsilonK * h
        edgeEps = edgeHitEpsK * h
        touch = high >= (bot - eps) and low <= (top + eps)

        pending0 = array.get(zPending, i)
        lastTouch = array.get(zLastTouchBar, i)
        if touch and bar_index != lastTouch
            array.set(zLastTouchBar, i, bar_index)
            array.set(zTouches, i, array.get(zTouches, i) + 1)

            if high >= (top - edgeEps)
                array.set(zUpperHits, i, array.get(zUpperHits, i) + 1)
            if low <= (bot + edgeEps)
                array.set(zLowerHits, i, array.get(zLowerHits, i) + 1)

            // Do not overwrite pending touch while waiting for reaction outcome.
            if not pending0
                array.set(zPending, i, true)
                array.set(zPendBar, i, bar_index)
                array.set(zPendHigh, i, high)
                array.set(zPendLow, i, low)
                bodyRef = side == SIDE_RESIST ? math.max(open, close) : math.min(open, close)
                array.set(zPendBody, i, bodyRef)

        pending = array.get(zPending, i)
        if pending
            pBar = array.get(zPendBar, i)
            pHigh = array.get(zPendHigh, i)
            pLow = array.get(zPendLow, i)
            pBody = array.get(zPendBody, i)
            elapsed = bar_index - pBar
            moveReq = math.max(reactionMoveK * h, syminfo.mintick * 2.0)

            reacted = (side == SIDE_RESIST and low <= pLow - moveReq) or (side == SIDE_SUPPORT and high >= pHigh + moveReq)

            if reacted
                array.set(zPending, i, false)
                array.set(zQTouches, i, array.get(zQTouches, i) + 1)

                // Expand boundaries from observed reaction touch structure
                if side == SIDE_RESIST
                    array.set(zTop, i, math.max(array.get(zTop, i), pHigh))
                    array.set(zBot, i, math.min(array.get(zBot, i), pBody))
                else
                    array.set(zBot, i, math.min(array.get(zBot, i), pLow))
                    array.set(zTop, i, math.max(array.get(zTop, i), pBody))

                f_rebuild_mid(i)
                f_reason("SR_TOUCH_REACTION_CONFIRMED", array.get(zMid, i), color.new(color.green, 10))
            else if elapsed > reactionWindowBars
                array.set(zPending, i, false)

        // force void tail for Pine if-branch type consistency
        array.set(zPending, i, array.get(zPending, i))

f_qualify_if_ready(i) =>
    st = array.get(zState, i)
    if st == STATE_CANDIDATE
        q = array.get(zQTouches, i)
        uh = array.get(zUpperHits, i)
        lh = array.get(zLowerHits, i)

        edgeOk = requireDualEdge ? (uh >= minEdgeHits and lh >= minEdgeHits) : (uh + lh >= minEdgeHits)
        if q >= minQualifiedTouches and edgeOk
            array.set(zState, i, STATE_QUALIFIED)
            f_reason("SR_ZONE_QUALIFIED_3T", array.get(zMid, i), color.new(color.blue, 0))

        // force void tail for Pine if-branch type consistency
        array.set(zState, i, array.get(zState, i))

f_flip_update(i) =>
    st = array.get(zState, i)
    if st != STATE_INVALID and st != STATE_CANDIDATE
        side = array.get(zSide, i)
        top = array.get(zTop, i)
        bot = array.get(zBot, i)
        h = f_height(top, bot)
        mid = array.get(zMid, i)
        breakBar = array.get(zBreakBar, i)
        sepSeen = array.get(zSepSeen, i)
        baseCount = array.get(zBaseCount, i)

        closeBreakTol = closeBreakTolK * h
        broke = (side == SIDE_SUPPORT and close < bot - closeBreakTol) or (side == SIDE_RESIST and close > top + closeBreakTol)

        if (st == STATE_QUALIFIED or st == STATE_FLIPPED) and broke
            st := STATE_FLIP_CAND
            breakBar := bar_index
            sepSeen := false
            baseCount := 0
            f_reason("SR_BREAK_CLOSE_CONFIRMED", mid, color.new(color.orange, 0))
            baseCount := baseCount

        if st == STATE_FLIP_CAND
            reclaimHit = (side == SIDE_SUPPORT and close > bot + reclaimK * h) or (side == SIDE_RESIST and close < top - reclaimK * h)
            if reclaimHit
                st := STATE_INVALID
                f_reason("SR_INVALID_RECLAIM", mid, color.new(color.red, 0))
                baseCount := baseCount
            else
                sepHit = (side == SIDE_SUPPORT and low < bot - sepK * h) or (side == SIDE_RESIST and high > top + sepK * h)
                if sepHit
                    sepSeen := true

                anchor = side == SIDE_SUPPORT ? bot - sepK * h : top + sepK * h
                inBase = math.abs(close - anchor) <= baseTolK * h
                baseCount := inBase ? (baseCount + 1) : 0

                timedOut = not na(breakBar) and (bar_index - breakBar > flipConfirmWindow)
                if timedOut and not (sepSeen and baseCount >= baseBarsMin)
                    st := STATE_QUALIFIED
                    breakBar := na
                    sepSeen := false
                    baseCount := 0
                    f_reason("SR_FLIP_CANDIDATE_CANCELLED", mid, color.new(color.gray, 10))
                    baseCount := baseCount

                if sepSeen and baseCount >= baseBarsMin and baseCount <= baseBarsMax
                    st := STATE_FLIPPED
                    side := side == SIDE_SUPPORT ? SIDE_RESIST : SIDE_SUPPORT
                    breakBar := na
                    sepSeen := false
                    baseCount := 0
                    // Reset touch counters only on confirmed flip
                    array.set(zTouches, i, 0)
                    array.set(zQTouches, i, 0)
                    array.set(zUpperHits, i, 0)
                    array.set(zLowerHits, i, 0)
                    f_reason("SR_FLIP_CONFIRMED", mid, color.new(color.aqua, 0))
                    breakBar := breakBar

        array.set(zState, i, st)
        array.set(zSide, i, side)
        array.set(zBreakBar, i, breakBar)
        array.set(zSepSeen, i, sepSeen)
        array.set(zBaseCount, i, baseCount)

f_compute_visibility() =>
    zCount = array.size(zTop)
    if zCount > 0
        for i = 0 to zCount - 1
            array.set(zVisible, i, false)

        hasQualifiedLike = false
        for i = 0 to zCount - 1
            st0 = array.get(zState, i)
            if st0 == STATE_QUALIFIED or st0 == STATE_FLIPPED or st0 == STATE_FLIP_CAND
                hasQualifiedLike := true

        for pick = 0 to maxDisplayZones - 1
            bestIdx = -1
            bestScore = -1e10

            for i = 0 to zCount - 1
                already = array.get(zVisible, i)
                st = array.get(zState, i)
                candidateAllowed = (showCandidates or (candidateFallback and not hasQualifiedLike)) and st == STATE_CANDIDATE
                displayable = st == STATE_QUALIFIED or st == STATE_FLIPPED or st == STATE_FLIP_CAND or candidateAllowed

                if (not already) and displayable and st != STATE_INVALID
                    sc = f_display_score(i)
                    if sc > bestScore
                        bestScore := sc
                        bestIdx := i

            if bestIdx >= 0
                array.set(zVisible, bestIdx, true)

f_render_zone(i) =>
    top = array.get(zTop, i)
    bot = array.get(zBot, i)
    mid = array.get(zMid, i)
    side = array.get(zSide, i)
    st = array.get(zState, i)
    origin = array.get(zOriginTime, i)
    vis = array.get(zVisible, i)

    f_cap_zone_height(i)
    top := array.get(zTop, i)
    bot := array.get(zBot, i)
    mid := array.get(zMid, i)

    b = array.get(zBox, i)
    l = array.get(zLine, i)

    if not na(b)
        box.set_left(b, origin)
        box.set_right(b, time)
        box.set_top(b, top)
        box.set_bottom(b, bot)

        fillC = vis ? f_fill_color(st, side) : color.new(color.white, 100)
        brdC = vis ? f_border_color(st, side) : color.new(color.white, 100)
        brdW = vis ? 3 : 1

        box.set_bgcolor(b, fillC)
        box.set_border_color(b, brdC)
        box.set_border_width(b, brdW)

    if not na(l)
        line.set_x1(l, origin)
        line.set_x2(l, time)
        line.set_y1(l, mid)
        line.set_y2(l, mid)
        lc = (vis and showZoneMidline) ? f_border_color(st, side) : color.new(color.white, 100)
        line.set_color(l, lc)
        line.set_width(l, vis ? 2 : 1)
        if showSideStyle
            line.set_style(l, side == SIDE_SUPPORT ? line.style_solid : line.style_dashed)

// ---------- Candidate generation from pivots ----------
ph = ta.pivothigh(high, pivotL, pivotR)
pl = ta.pivotlow(low, pivotL, pivotR)

if not na(ph)
    pTop = high[pivotR]
    pBot = math.max(open[pivotR], close[pivotR])
    if pTop <= pBot
        pBot := pTop - syminfo.mintick * 2.0
    str = (high[pivotR] - low[pivotR]) / math.max(atrv[pivotR], syminfo.mintick)
    if str >= minPivotStrength
        f_new_zone(pTop, pBot, SIDE_RESIST, str, time[pivotR])

if not na(pl)
    pTop = math.min(open[pivotR], close[pivotR])
    pBot = low[pivotR]
    if pTop <= pBot
        pTop := pBot + syminfo.mintick * 2.0
    str = (high[pivotR] - low[pivotR]) / math.max(atrv[pivotR], syminfo.mintick)
    if str >= minPivotStrength
        f_new_zone(pTop, pBot, SIDE_SUPPORT, str, time[pivotR])

// ---------- Per-zone updates ----------
zCount = array.size(zTop)
if zCount > 0
    for i = 0 to zCount - 1
        f_touch_reaction_update(i)
        f_qualify_if_ready(i)
        f_flip_update(i)

    f_compute_visibility()

    for i = 0 to zCount - 1
        f_render_zone(i)

// ---------- HTF markers ----------
htfPh = request.security(syminfo.tickerid, htfTf, ta.pivothigh(high, pivotL, pivotR), barmerge.gaps_off, barmerge.lookahead_off)
htfPl = request.security(syminfo.tickerid, htfTf, ta.pivotlow(low, pivotL, pivotR), barmerge.gaps_off, barmerge.lookahead_off)
plot(showHtfMarkers ? htfPh : na, "HTF Pivot High", color=color.new(color.fuchsia, 40), style=plot.style_circles, linewidth=1)
plot(showHtfMarkers ? htfPl : na, "HTF Pivot Low", color=color.new(color.lime, 40), style=plot.style_circles, linewidth=1)

// ---------- Debug table ----------
var table t = table.new(position.top_right, 2, 10, border_width=1)
if barstate.islast and showDebugTable
    cand = 0
    qual = 0
    flipc = 0
    flipd = 0
    inval = 0
    disp = 0
    dispSup = 0
    dispRes = 0
    float nearestMid = na
    string nearestState = "-"
    float nearestDistPct = na

    if zCount > 0
        bestDist = 1e10
        tgt = diagTargetPrice > 0.0 ? diagTargetPrice : close
        for i = 0 to zCount - 1
            s = array.get(zState, i)
            v = array.get(zVisible, i)
            sd = array.get(zSide, i)
            m = array.get(zMid, i)
            cand += s == STATE_CANDIDATE ? 1 : 0
            qual += s == STATE_QUALIFIED ? 1 : 0
            flipc += s == STATE_FLIP_CAND ? 1 : 0
            flipd += s == STATE_FLIPPED ? 1 : 0
            inval += s == STATE_INVALID ? 1 : 0
            disp += v ? 1 : 0
            dispSup += (v and sd == SIDE_SUPPORT) ? 1 : 0
            dispRes += (v and sd == SIDE_RESIST) ? 1 : 0

            d = math.abs(m - tgt)
            if d < bestDist
                bestDist := d
                nearestMid := m
                nearestState := f_state_name(s)
                nearestDistPct := d / math.max(tgt, syminfo.mintick) * 100.0

    table.cell(t, 0, 0, "Zones pool", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 1, 0, str.tostring(zCount), text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(t, 0, 1, "Candidate", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(cand), text_color=color.white)
    table.cell(t, 0, 2, "Qualified", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(qual), text_color=color.white)
    table.cell(t, 0, 3, "FlipCand/Flipped", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(flipc) + "/" + str.tostring(flipd), text_color=color.white)
    table.cell(t, 0, 4, "Invalid", text_color=color.white)
    table.cell(t, 1, 4, str.tostring(inval), text_color=color.white)
    table.cell(t, 0, 5, "Displayed", text_color=color.white)
    table.cell(t, 1, 5, str.tostring(disp), text_color=color.white)
    table.cell(t, 0, 6, "Disp Sup/Res", text_color=color.white)
    table.cell(t, 1, 6, str.tostring(dispSup) + "/" + str.tostring(dispRes), text_color=color.white)
    table.cell(t, 0, 7, "Legend", text_color=color.white)
    legendTxt = colorBySide ? "SUP=green RES=purple" : "LEVELS=blue (side-neutral)"
    table.cell(t, 1, 7, legendTxt, text_color=color.new(color.white, 0))
    table.cell(t, 0, 8, "Nearest to target", text_color=color.white)
    nearTxt = showDiagTarget and not na(nearestMid) ? (str.tostring(nearestMid, format.mintick) + " (" + nearestState + ")") : "-"
    table.cell(t, 1, 8, nearTxt, text_color=color.new(color.white, 0))
    table.cell(t, 0, 9, "Target dist %", text_color=color.white)
    distTxt = showDiagTarget and not na(nearestDistPct) ? str.tostring(nearestDistPct, "#.##") + "%" : "-"
    table.cell(t, 1, 9, distTxt, text_color=color.new(color.white, 0))
