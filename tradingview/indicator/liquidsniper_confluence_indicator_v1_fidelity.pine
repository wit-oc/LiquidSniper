//@version=5
indicator("LiquidSniper Confluence Indicator v1 (Mentorship Fidelity)", overlay=true, max_labels_count=500)

// ------------------------------------------------------
// LiquidSniper Pine v1 - Mentorship fidelity pass
// Core intent from Foxian mentorship:
// - Confluence = edge stack, not a single signal
// - Respect MTF structure + trend context
// - Favor first retest after structure displacement
// - Reduce participation in choppy/sideways conditions
// - Confirm with candle close where possible
// ------------------------------------------------------

// ===== Inputs =====
g_meta = "00. Metadata"
ls_version = input.string("tv-indicator-v1.0.0-fidelity", "Logic Version", group=g_meta)
profile = input.string("I", "Profile (C/I/S)", options=["C", "I", "S"], group=g_meta)
show_debug = input.bool(false, "Show Debug Table", group=g_meta)

g_logic = "01. Logic"
require_candle_close = input.bool(true, "Require Candle Close", group=g_logic)
structure_swing_len = input.int(3, "Structure Swing Length", minval=2, maxval=10, group=g_logic)
retest_window_bars = input.int(24, "Retest Window Bars", minval=3, maxval=300, group=g_logic)
retest_bps = input.float(20.0, "Retest Zone (bps)", minval=2.0, maxval=250.0, group=g_logic)
chop_ci_max = input.float(61.0, "HTF Chop CI Max", minval=20.0, maxval=80.0, group=g_logic)
chop_adx_min = input.float(17.0, "HTF Trend ADX Min", minval=5.0, maxval=60.0, group=g_logic)
watch_score = input.float(6.0, "Watch Score Min", minval=0.0, maxval=10.0, group=g_logic)
trigger_score = input.float(7.2, "Trigger Score Min", minval=0.0, maxval=10.0, group=g_logic)

g_vis = "02. Visuals"
show_sr_zone = input.bool(true, "Show Retest Zone", group=g_vis)
show_watch_labels = input.bool(true, "Show Watch Labels", group=g_vis)
show_trigger_labels = input.bool(true, "Show Trigger Labels", group=g_vis)

// ===== Helpers =====
clamp(v, lo, hi) => math.max(lo, math.min(hi, v))
safe_div(n, d) => d == 0.0 ? 0.0 : n / d

// ===== Profile TF map =====
entry_tf = profile == "S" ? "60" : profile == "I" ? "15" : "5"
itf_tf = profile == "S" ? "240" : profile == "I" ? "60" : "15"
htf_tf = profile == "S" ? "D" : profile == "I" ? "240" : "60"

// ===== MTF baselines =====
entry_close = request.security(syminfo.tickerid, entry_tf, close)
entry_high = request.security(syminfo.tickerid, entry_tf, high)
entry_low = request.security(syminfo.tickerid, entry_tf, low)
entry_ema20 = request.security(syminfo.tickerid, entry_tf, ta.ema(close, 20))
entry_ema50 = request.security(syminfo.tickerid, entry_tf, ta.ema(close, 50))
itf_ema20 = request.security(syminfo.tickerid, itf_tf, ta.ema(close, 20))
itf_ema50 = request.security(syminfo.tickerid, itf_tf, ta.ema(close, 50))
htf_ema20 = request.security(syminfo.tickerid, htf_tf, ta.ema(close, 20))
htf_ema50 = request.security(syminfo.tickerid, htf_tf, ta.ema(close, 50))

// ===== Trend context =====
trend_long = itf_ema20 > itf_ema50 and htf_ema20 > htf_ema50
trend_short = itf_ema20 < itf_ema50 and htf_ema20 < htf_ema50
trend_dir = trend_long ? 1 : trend_short ? -1 : 0

// ===== Structure (BoS / CHoCH approximation from swings) =====
piv_hi = ta.pivothigh(entry_high, structure_swing_len, structure_swing_len)
piv_lo = ta.pivotlow(entry_low, structure_swing_len, structure_swing_len)

var float last_swing_high = na
var float last_swing_low = na
if not na(piv_hi)
    last_swing_high := piv_hi
if not na(piv_lo)
    last_swing_low := piv_lo

bos_up = not na(last_swing_high) and entry_close > last_swing_high
bos_down = not na(last_swing_low) and entry_close < last_swing_low

var int structure_dir = 0
prior_structure_dir = structure_dir
if bos_up
    structure_dir := 1
if bos_down
    structure_dir := -1

choch_up = bos_up and prior_structure_dir == -1
choch_down = bos_down and prior_structure_dir == 1

// ===== Chop filter (avoid sideways) =====
chop_len = 14
htf_tr_sum = request.security(syminfo.tickerid, htf_tf, ta.sma(ta.tr(true), chop_len) * chop_len)
htf_span = request.security(syminfo.tickerid, htf_tf, ta.highest(high, chop_len) - ta.lowest(low, chop_len))
htf_ci_raw = htf_span <= 1e-9 ? 100.0 : 100.0 * math.log10(math.max(htf_tr_sum / htf_span, 1e-9)) / math.log10(chop_len)
htf_ci = clamp(htf_ci_raw, 0.0, 100.0)
htf_adx = request.security(syminfo.tickerid, htf_tf, ta.adx(14))
chop_ok = htf_ci <= chop_ci_max and htf_adx >= chop_adx_min

// ===== First retest engine (on ITF EMA50 as dynamic SR proxy) =====
sr_anchor = itf_ema50
zone_half = sr_anchor * (retest_bps / 10000.0)
zone_top = sr_anchor + zone_half
zone_bot = sr_anchor - zone_half

touch_zone = entry_high >= zone_bot and entry_low <= zone_top
zone_touch_event = touch_zone and not touch_zone[1]

var bool long_retest_armed = false
var bool short_retest_armed = false
var int long_retest_count = 0
var int short_retest_count = 0
var int bars_since_long_bos = 1000000
var int bars_since_short_bos = 1000000

bars_since_long_bos += 1
bars_since_short_bos += 1

if bos_up
    long_retest_armed := true
    long_retest_count := 0
    bars_since_long_bos := 0
    short_retest_armed := false

if bos_down
    short_retest_armed := true
    short_retest_count := 0
    bars_since_short_bos := 0
    long_retest_armed := false

if bars_since_long_bos > retest_window_bars
    long_retest_armed := false
if bars_since_short_bos > retest_window_bars
    short_retest_armed := false

long_first_retest = false
short_first_retest = false

if zone_touch_event and long_retest_armed and trend_dir >= 0
    long_retest_count += 1
    long_first_retest := long_retest_count == 1
    if long_retest_count >= 1
        long_retest_armed := false

if zone_touch_event and short_retest_armed and trend_dir <= 0
    short_retest_count += 1
    short_first_retest := short_retest_count == 1
    if short_retest_count >= 1
        short_retest_armed := false

// ===== Confluence score (0..10) =====
candle_ok = not require_candle_close or barstate.isconfirmed
ema_stack_long = entry_close > entry_ema20 and entry_ema20 > entry_ema50
ema_stack_short = entry_close < entry_ema20 and entry_ema20 < entry_ema50

score_long = 0.0
score_long += trend_long ? 2.0 : 0.0
score_long += (bos_up or choch_up) ? 2.0 : 0.0
score_long += long_first_retest ? 2.0 : 0.0
score_long += ema_stack_long ? 1.0 : 0.0
score_long += chop_ok ? 1.0 : 0.0
score_long += candle_ok ? 1.0 : 0.0
score_long += entry_close > sr_anchor ? 1.0 : 0.0

score_short = 0.0
score_short += trend_short ? 2.0 : 0.0
score_short += (bos_down or choch_down) ? 2.0 : 0.0
score_short += short_first_retest ? 2.0 : 0.0
score_short += ema_stack_short ? 1.0 : 0.0
score_short += chop_ok ? 1.0 : 0.0
score_short += candle_ok ? 1.0 : 0.0
score_short += entry_close < sr_anchor ? 1.0 : 0.0

long_watch = score_long >= watch_score and candle_ok
short_watch = score_short >= watch_score and candle_ok
long_trigger = score_long >= trigger_score and candle_ok and chop_ok and trend_dir >= 0
short_trigger = score_short >= trigger_score and candle_ok and chop_ok and trend_dir <= 0

// ===== Plots / labels / alerts =====
plot(entry_ema20, "Entry EMA20", color=color.new(color.teal, 0))
plot(entry_ema50, "Entry EMA50", color=color.new(color.orange, 0))
plot(sr_anchor, "ITF EMA50 SR Anchor", color=color.new(color.blue, 20))

p_top = plot(show_sr_zone ? zone_top : na, "Retest Zone Top", color=color.new(color.green, 70))
p_bot = plot(show_sr_zone ? zone_bot : na, "Retest Zone Bottom", color=color.new(color.red, 70))
fill(p_top, p_bot, color=color.new(color.blue, 92), title="Retest Zone")

if show_watch_labels and long_watch and not long_trigger
    label.new(bar_index, low, "LONG WATCH\nS=" + str.tostring(score_long, "#.0"), style=label.style_label_up, color=color.new(color.green, 70), textcolor=color.white)
if show_watch_labels and short_watch and not short_trigger
    label.new(bar_index, high, "SHORT WATCH\nS=" + str.tostring(score_short, "#.0"), style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.white)

if show_trigger_labels and long_trigger
    label.new(bar_index, low, "LONG TRIGGER\nS=" + str.tostring(score_long, "#.0"), style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white)
if show_trigger_labels and short_trigger
    label.new(bar_index, high, "SHORT TRIGGER\nS=" + str.tostring(score_short, "#.0"), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)

alertcondition(long_watch, "LS v1 Long Watch", "LiquidSniper v1 LONG WATCH {{ticker}} {{interval}}")
alertcondition(short_watch, "LS v1 Short Watch", "LiquidSniper v1 SHORT WATCH {{ticker}} {{interval}}")
alertcondition(long_trigger, "LS v1 Long Trigger", "LiquidSniper v1 LONG TRIGGER {{ticker}} {{interval}}")
alertcondition(short_trigger, "LS v1 Short Trigger", "LiquidSniper v1 SHORT TRIGGER {{ticker}} {{interval}}")

if show_debug
    var table t = table.new(position.top_right, 2, 14, border_width=1)
    table.cell(t, 0, 0, "Version")
    table.cell(t, 1, 0, ls_version)
    table.cell(t, 0, 1, "Profile")
    table.cell(t, 1, 1, profile)
    table.cell(t, 0, 2, "Trend")
    table.cell(t, 1, 2, trend_dir == 1 ? "LONG" : trend_dir == -1 ? "SHORT" : "NEUTRAL")
    table.cell(t, 0, 3, "BoS Up/Down")
    table.cell(t, 1, 3, (bos_up ? "Y" : "N") + "/" + (bos_down ? "Y" : "N"))
    table.cell(t, 0, 4, "CHoCH Up/Down")
    table.cell(t, 1, 4, (choch_up ? "Y" : "N") + "/" + (choch_down ? "Y" : "N"))
    table.cell(t, 0, 5, "Chop OK")
    table.cell(t, 1, 5, chop_ok ? "Y" : "N")
    table.cell(t, 0, 6, "HTF CI")
    table.cell(t, 1, 6, str.tostring(htf_ci, "#.0"))
    table.cell(t, 0, 7, "HTF ADX")
    table.cell(t, 1, 7, str.tostring(htf_adx, "#.0"))
    table.cell(t, 0, 8, "L 1st Retest")
    table.cell(t, 1, 8, long_first_retest ? "Y" : "N")
    table.cell(t, 0, 9, "S 1st Retest")
    table.cell(t, 1, 9, short_first_retest ? "Y" : "N")
    table.cell(t, 0, 10, "Score Long")
    table.cell(t, 1, 10, str.tostring(score_long, "#.0"))
    table.cell(t, 0, 11, "Score Short")
    table.cell(t, 1, 11, str.tostring(score_short, "#.0"))
    table.cell(t, 0, 12, "Long/Short Trigger")
    table.cell(t, 1, 12, (long_trigger ? "Y" : "N") + "/" + (short_trigger ? "Y" : "N"))
    table.cell(t, 0, 13, "TF")
    table.cell(t, 1, 13, timeframe.period)
